{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "piru-sync-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "APPLE_AUDIENCE": "glass.kagerou.piru" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "piru-sync-local",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "piru-sync-local" }],
  "triggers": { "crons": ["17 * * * *"] },
  "env": {
    "staging": {
      "name": "piru-sync-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": { "APPLE_AUDIENCE": "glass.kagerou.piru" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "piru-sync-staging",
          "database_id": "00000000-0000-4000-8000-000000000002",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        { "binding": "BLOBS", "bucket_name": "piru-sync-staging" },
      ],
      "triggers": { "crons": ["17 * * * *"] },
    },
  },
}
